# BatikCode CI: npx must never prompt.
#
# Some transitive git dependencies (simple-socks, ssh2) run `npx <pkg> --update-db`
# in their `prepare` script. On CI runners stdin is closed, so npx's "Ok to
# proceed? (y)" confirmation reads EOF and the install hangs then dies with a
# silent exit 1. Auto-confirm instead so those scripts run unattended.
yes=true

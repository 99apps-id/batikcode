{
  "name": "tunnel-forwarding",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "10.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "icon": "media/icon.png",
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Publishing a local port requires a trusted workspace."
    }
  },
  "enabledApiProposals": [
    "resolvers",
    "tunnelFactory"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTunnel",
    "onCommand:batikcode.devTunnel.start",
    "onCommand:batikcode.devTunnel.stopAll",
    "onCommand:batikcode.devTunnel.selectCloudflared",
    "onCommand:batikcode.devTunnel.openDownload",
    "onCommand:tunnel-forwarding.showLog"
  ],
  "contributes": {
    "commands": [
      {
        "category": "%category%",
        "command": "tunnel-forwarding.showLog",
        "title": "%command.showLog%",
        "enablement": "tunnelForwardingHasLog"
      },
      {
        "category": "%category%",
        "command": "batikcode.devTunnel.start",
        "title": "%command.start%",
        "icon": "$(cloud-upload)"
      },
      {
        "category": "%category%",
        "command": "batikcode.devTunnel.stopAll",
        "title": "%command.stopAll%",
        "icon": "$(debug-stop)",
        "enablement": "batikcodeDevTunnelActive"
      },
      {
        "category": "%category%",
        "command": "batikcode.devTunnel.selectCloudflared",
        "title": "%command.selectCloudflared%"
      },
      {
        "category": "%category%",
        "command": "batikcode.devTunnel.openDownload",
        "title": "%command.openDownload%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "batikcode.devTunnel.start"
        },
        {
          "command": "batikcode.devTunnel.stopAll",
          "when": "batikcodeDevTunnelActive"
        },
        {
          "command": "batikcode.devTunnel.selectCloudflared"
        },
        {
          "command": "batikcode.devTunnel.openDownload"
        },
        {
          "command": "tunnel-forwarding.showLog",
          "when": "tunnelForwardingHasLog"
        }
      ]
    },
    "configuration": {
      "title": "BatikCode Dev Tunnel",
      "properties": {
        "batikcode.devTunnel.cloudflaredPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional absolute path to the cloudflared executable. When empty, BatikCode uses cloudflared from PATH."
        }
      }
    }
  },
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:tunnel-forwarding",
    "watch": "gulp watch-extension:tunnel-forwarding"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "prettier": {
    "printWidth": 100,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
